# EditorialOS configuration. Copy to .env.local for local development.
# Placeholders only. Never commit real values.

# ---------------------------------------------------------------------------
# Public (exposed to the browser). Safe to share; protected by RLS.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Optional product name shown in the UI.
NEXT_PUBLIC_PRODUCT_NAME=EditorialOS

# ---------------------------------------------------------------------------
# Server only (Vercel "Production" + "Preview" env vars; never NEXT_PUBLIC_).
# ---------------------------------------------------------------------------
# Supabase secret key (sb_secret_...) or the legacy service_role key. Bypasses RLS: server only.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# OpenRouter: the only AI gateway. Only google/* models are allowed, and every
# request is pinned to Google infrastructure (provider.only, no fallbacks).
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_TEXT_MODEL=google/gemini-3.7-flash
OPENROUTER_RESEARCH_MODEL=google/gemini-3.7-flash
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
OPENROUTER_PROVIDER_ONLY=google-vertex,google-ai-studio
# server_tool = openrouter:web_search tool (recommended); plugin = legacy "web" plugin
OPENROUTER_WEB_SEARCH_MODE=server_tool
OPENROUTER_WEB_MAX_RESULTS=8
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 32-byte key for AES-256-GCM encryption of WordPress application passwords.
# Generate: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
CREDENTIALS_ENCRYPTION_KEY_ID=k1
# During key rotation, keep the old key here until credentials are re-saved:
# CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=
# CREDENTIALS_ENCRYPTION_KEY_PREVIOUS_ID=

# Shared secret between Supabase Cron (stored in Supabase Vault) and the app.
# Generate: openssl rand -hex 32   (at least 32 characters)
CRON_SECRET=REPLACE_WITH_RANDOM_HEX

# Public URL of the deployment (used for auth email links and as the scheduler target).
APP_BASE_URL=https://your-app.vercel.app

# Development only: use an in-memory WordPress instead of the real site. Ignored in production.
EDITORIALOS_MOCK_PROVIDERS=false
